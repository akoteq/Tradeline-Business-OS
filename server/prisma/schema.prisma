generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CEO
  BDO
}

enum Company {
  BAPX
  TRADELINE
}

enum DealHealth {
  ACTIVE
  STALE
  AT_RISK
  CLOSED_WON
  CLOSED_LOST
}

enum DealStage {
  QUALIFICATION
  DISCOVERY
  PROPOSAL_SENT
  NEGOTIATION
  CONTRACT_REVIEW
  CLOSED_WON
  CLOSED_LOST
  ON_HOLD
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  IN_PROGRESS
  CONVERTED
  LOST
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
  OVERDUE
}

enum SMEStatus {
  IN_PROGRESS
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PartnershipStatus {
  ACTIVE
  PENDING
  EXPIRED
  SUSPENDED
}

enum GrantLoanStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DISBURSED
  REJECTED
  WITHDRAWN
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum BankabilityTier {
  TIER_1
  TIER_2
  TIER_3
  UNSCORED
}

enum Tier {
  TIER_1
  TIER_2
  TIER_3
}

// ─── Users (auth) ────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  passwordHash String
  role         Role      @default(BDO)
  bdoId        String?   @db.ObjectId
  name         String?
  inviteToken  String?   @unique
  inviteExpiry DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── BDO (Business Development Officers) ──────────────────────────────────────

model BDO {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String?  @unique
  phone     String?
  company   Company
  role      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bapxDeals      BapxDeal[]
  tradelineDeals TradelineDeal[]
  leads          Lead[]
  grantLoans     GrantLoanTracker[]
  tasks          Task[]
  activityLogs   ActivityLog[]
  monthlyKpis    MonthlyKpi[]
}

// ─── SME (Small & Medium Enterprise) ──────────────────────────────────────────

model SME {
  id                    String          @id @default(auto()) @map("_id") @db.ObjectId
  bizId                 String?         @unique
  companyName           String
  contactName           String?
  email                 String?
  phone                 String?
  valueChain            String?
  region                String?
  district              String?
  businessDescription   String?
  status                SMEStatus       @default(IN_PROGRESS)
  followUpDate          DateTime?
  investorReadinessScore Int?
  bankabilityTier       BankabilityTier @default(UNSCORED)
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  bapxDeals      BapxDeal[]
  tradelineDeals TradelineDeal[]
  leads          Lead[]
  grantLoans     GrantLoanTracker[]
}

// ─── BAPX Pipeline ────────────────────────────────────────────────────────────

model BapxDeal {
  id                    String     @id @default(auto()) @map("_id") @db.ObjectId
  bizId                 String?    @unique
  dealHealth            DealHealth @default(ACTIVE)
  date                  DateTime?
  businessName          String
  clientName            String?
  holdingFirm           String?
  industry              String?
  telephone             String?
  region                String?
  email                 String?
  bdoId                 String?    @db.ObjectId
  bdo                   BDO?       @relation(fields: [bdoId], references: [id])
  activityType          String?
  keyTopics             String?
  callOutcome           String?
  product               String?
  dealStage             DealStage  @default(QUALIFICATION)
  priority              Priority   @default(MEDIUM)
  nextSteps             String?
  nextCallDate          DateTime?
  targetGhs             Float?
  daysSinceLastContact  Int?
  aiCoachRecommendation String?
  smeId                 String?    @db.ObjectId
  sme                   SME?       @relation(fields: [smeId], references: [id])
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

// ─── Tradeline Pipeline ───────────────────────────────────────────────────────

model TradelineDeal {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  bizId               String?       @unique
  serialNo            Int?
  businessName        String
  valueChain          String?
  bdoId               String?       @db.ObjectId
  bdo                 BDO?          @relation(fields: [bdoId], references: [id])
  tier                Tier          @default(TIER_1)
  email               String?
  telephone           String?
  currentStatus       String?
  nextAction          String?
  requiredInvestment  String?
  revenuePotentialGhs Float?
  dueDate             DateTime?
  revenueReceivedGhs  Float?        @default(0)
  balanceGhs          Float?
  paymentStatus       PaymentStatus @default(UNPAID)
  dealStage           DealStage     @default(QUALIFICATION)
  priority            Priority      @default(MEDIUM)
  dealHealth          DealHealth    @default(ACTIVE)
  smeId               String?       @db.ObjectId
  sme                 SME?          @relation(fields: [smeId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

// ─── Leads Database ───────────────────────────────────────────────────────────

model Lead {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  bizId         String?    @unique
  businessName  String
  email         String?
  contactPerson String?
  roleTitle     String?
  status        LeadStatus @default(NEW)
  source        String?
  bdoId         String?    @db.ObjectId
  bdo           BDO?       @relation(fields: [bdoId], references: [id])
  priority      Priority?
  dateAdded     DateTime?
  followUpDate  DateTime?
  notes         String?
  smeId         String?    @db.ObjectId
  sme           SME?       @relation(fields: [smeId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// ─── Consolidated Registry ────────────────────────────────────────────────────

model ConsolidatedRecord {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  serialNo       Int?
  businessName   String
  contactPerson  String?
  emailPhone     String?
  region         String?
  valueChain     String?
  dealValue      Float?
  priority       Priority?
  pipelineStatus String?
  duplicateFlag  Boolean   @default(false)
  sourceFirm     Company?
  assignedBdo    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─── Partnerships ─────────────────────────────────────────────────────────────

model Partnership {
  id                  String            @id @default(auto()) @map("_id") @db.ObjectId
  partnerOrganisation String
  contactPerson       String?
  contactEmailPhone   String?
  partnershipType     String?
  tradelineEntity     Company?
  valueChainSector    String?
  country             String?
  agreementType       String?
  startDate           DateTime?
  endRenewalDate      DateTime?
  status              PartnershipStatus @default(ACTIVE)
  revenueSharePct     Float?
  revenueGeneratedGhs Float?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

// ─── Grant & Loan Tracker ─────────────────────────────────────────────────────

model GrantLoanTracker {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  clientName         String
  bdoId              String?         @db.ObjectId
  bdo                BDO?            @relation(fields: [bdoId], references: [id])
  grantLoanType      String?
  funderDfi          String?
  sectorValueChain   String?
  amountApplied      String?
  amountApproved     Float?
  disbursed          Float?
  applicationDate    DateTime?
  decisionDate       DateTime?
  status             GrantLoanStatus @default(SUBMITTED)
  commissionPct      Float?          @default(10)
  commissionReceived Float?
  notes              String?
  smeId              String?         @db.ObjectId
  sme                SME?            @relation(fields: [smeId], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// ─── KPI Scorecard ────────────────────────────────────────────────────────────

model KpiScorecard {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  month           DateTime
  company         Company
  kpiMetric       String
  currentValue    Float?
  unit            String?
  benchmarkTarget Float?
  status          String?
  managementNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Fred Phillips Performance Tracker ───────────────────────────────────────

model ActivityLog {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  taskNo      Int?
  category    String?
  description String
  startWeek   String?
  endWeek     String?
  progress    Float?     @default(0)
  status      TaskStatus @default(PENDING)
  notes       String?
  bdoId       String?    @db.ObjectId
  bdo         BDO?       @relation(fields: [bdoId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MonthlyKpi {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  serialNo Int?
  category String?
  metric   String
  bdoId    String?  @db.ObjectId
  bdo      BDO?     @relation(fields: [bdoId], references: [id])
  month    DateTime
  target   Float?
  actual   Float?
  notes    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Scheme of Work / Tasks ───────────────────────────────────────────────────

model Task {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  year        Int?
  priority    Priority   @default(MEDIUM)
  deliverable String
  targetDate  String?
  bdoId       String?    @db.ObjectId
  bdo         BDO?       @relation(fields: [bdoId], references: [id])
  status      TaskStatus @default(PENDING)
  company     Company?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ─── Follow-Up Tracker ────────────────────────────────────────────────────────

model FollowUp {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  entityType  String
  entityId    String
  assignedTo  String?
  dueDate     DateTime
  notes       String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

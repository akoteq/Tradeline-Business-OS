DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tradeline_bapx?retryWrites=true&w=majority"
PORT=4000
# Comma-separated list of allowed origins (e.g. for multiple Vercel deployments)
CLIENT_URL=http://localhost:3000,https://afrca-osss-client-w9vb.vercel.app
NODE_ENV=development
# Public dashboard URL used in invite emails.
DASHBOARD_URL=https://afrca-osss-client-w9vb.vercel.app

# Email / SMTP notifications (Gmail example).
# SMTP_PASS should be a Gmail App Password (https://myaccount.google.com/apppasswords), no spaces.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Tradeline & BAPX <you@gmail.com>"

# Personalised daily digest scheduler (morning + evening). Times use DIGEST_TIMEZONE.
DIGEST_ENABLED=true
DIGEST_TIMEZONE=Africa/Accra
DIGEST_MORNING_CRON=0 7 * * *
DIGEST_EVENING_CRON=0 17 * * *

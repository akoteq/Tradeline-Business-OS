          }
        },
        {
          "name": "Link User to BDO Profile [ADMIN/CEO]",
          "request": {
            "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/users/:id/bdo", "host": ["{{baseUrl}}"], "path": ["auth", "users", ":id", "bdo"], "variable": [{ "key": "id", "value": "" }] },
            "body": { "mode": "raw", "raw": "{\n  \"bdoId\": \"<bdo-profile-id>\"\n}" }
          }
        },
        {
          "name": "Delete User [ADMIN/CEO]",
          "request": {
            "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/users/:id", "host": ["{{baseUrl}}"], "path": ["auth", "users", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        }
      ]
    },

    {
      "name": "Staff Profiles (BDO)",
      "description": "Staff profile management. GET list is scoped: BUSINESS_CEO sees own company only; individual BDOs see all (for dropdowns). POST/PUT/DELETE require ADMIN/CEO.",

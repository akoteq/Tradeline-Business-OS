{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Tradeline & BAPX API",
    "description": "Tradeline Holdings Business Operating System API. Set baseUrl variable (default: http://localhost:4000/api). Run Login first to auto-save the token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json(); if (r.token) pm.collectionVariables.set('token', r.token);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"tiisusharif1@gmail.com\",\n  \"password\": \"pass1234\"\n}" }
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Change Own Password",
          "request": {
            "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/me/password", "host": ["{{baseUrl}}"], "path": ["auth", "me", "password"] },
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"newPassword123\"\n}" }
          }
        },
        {
          "name": "List Users [ADMIN/CEO]",
          "request": {
            "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/users", "host": ["{{baseUrl}}"], "path": ["auth", "users"] }
          }
        },
        {
          "name": "Create User [ADMIN/CEO]",
          "request": {
            "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/users", "host": ["{{baseUrl}}"], "path": ["auth", "users"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"temp1234\",\n  \"role\": \"BDO\",\n  \"bdoId\": null\n}" }
          }
        },
        {
          "name": "Onboard Team Member [ADMIN/CEO]",
          "request": {
            "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/onboard", "host": ["{{baseUrl}}"], "path": ["auth", "onboard"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"+233200000000\",\n  \"company\": \"TRADELINE\",\n  \"role\": \"Senior BDO\",\n  \"accessRole\": \"BDO\"\n}" }
          }
        },
        {
          "name": "Invite Existing Staff Profile [ADMIN/CEO]",
          "request": {
            "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/bdos/:bdoId/invite", "host": ["{{baseUrl}}"], "path": ["auth", "bdos", ":bdoId", "invite"], "variable": [{ "key": "bdoId", "value": "" }] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"staff@example.com\",\n  \"accessRole\": \"BDO\"\n}" }
          }
        },
        {
          "name": "Resend Invite [ADMIN/CEO]",
          "request": {
            "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/users/:id/resend-invite", "host": ["{{baseUrl}}"], "path": ["auth", "users", ":id", "resend-invite"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Reset User Password [ADMIN/CEO]",
          "request": {
            "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/users/:id/password", "host": ["{{baseUrl}}"], "path": ["auth", "users", ":id", "password"], "variable": [{ "key": "id", "value": "" }] },
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"newTemp123\"\n}" }
          }
        },
        {
          "name": "Change User Role [ADMIN/CEO]",
          "request": {
            "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
